---
const { project } = Astro.props;
const d = project.data;
const dateStr = d.date
  ? new Date(d.date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })
  : null;
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{d.title} · Steven Garcia</title>
<meta name="description" content={d.description} />
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Condensed:wght@600;700&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<style is:global>
:root{
  --paper:#EDEFEA; --paper-2:#E4E7E0; --paper-3:#D9DED4;
  --ink:#121615; --ink-2:#3B443F; --muted:#6E7A73; --muted-2:#939E96;
  --line:#C9CFC5; --line-2:#DBDFD6;
  --oxide:#A0391F; --steel:#2B4759; --deck:#2E6049;
  --night:#12181B; --night-2:#1A2226; --night-line:#2C3840;
  --disp:'IBM Plex Sans Condensed',sans-serif;
  --body:'IBM Plex Sans',system-ui,sans-serif;
  --mono:'IBM Plex Mono',ui-monospace,monospace;
  --wrap:1220px; --read:760px;
}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{background:var(--paper);color:var(--ink-2);font-family:var(--body);font-size:17px;line-height:1.62;-webkit-font-smoothing:antialiased;overflow-x:hidden}
.wrap{max-width:var(--wrap);margin:0 auto;padding:0 34px}
.read{max-width:var(--read);margin:0 auto;padding:0 34px}

/* nav */
.nav{position:sticky;top:0;z-index:80;background:rgba(237,239,234,.94);backdrop-filter:blur(14px);border-bottom:1px solid var(--line)}
.nav-in{display:flex;align-items:center;justify-content:space-between;height:60px}
.brand{font-family:var(--mono);font-size:13px;font-weight:600;text-decoration:none;display:flex;align-items:center;gap:9px;color:var(--ink)}
.led{width:7px;height:7px;border-radius:50%;background:var(--deck);animation:blip 2.6s infinite}
@keyframes blip{0%,100%{opacity:1}50%{opacity:.3}}
.nav-links{display:flex;align-items:center;gap:24px;font-family:var(--mono);font-size:12.5px}
.nav-links a{color:var(--muted);text-decoration:none}
.nav-links a:hover{color:var(--oxide)}
.nav-cta{background:var(--ink);color:var(--paper)!important;padding:8px 16px;border-radius:3px}
.nav-cta:hover{background:var(--oxide);color:#fff!important}

/* project header */
.phead{position:relative;background:var(--night);overflow:hidden;padding:70px 0 54px}
.phead-bg{position:absolute;inset:0}
.phead-bg img{width:100%;height:100%;object-fit:cover;filter:grayscale(1) contrast(1.15) brightness(.42)}
.phead-bg::after{content:'';position:absolute;inset:0;background:linear-gradient(120deg,#A0391F 0%,#2B4759 100%);mix-blend-mode:color;opacity:.9}
.phead-scrim{position:absolute;inset:0;background:linear-gradient(90deg,rgba(10,14,16,.94) 0%,rgba(10,14,16,.72) 60%,rgba(10,14,16,.55) 100%)}
.phead-in{position:relative;z-index:2}
.crumb{font-family:var(--mono);font-size:11.5px;letter-spacing:.16em;text-transform:uppercase;color:rgba(255,255,255,.5);margin-bottom:18px}
.crumb a{color:#F0A183;text-decoration:none}
.crumb a:hover{text-decoration:underline}
.phead h1{font-family:var(--disp);font-weight:700;font-size:clamp(34px,5.2vw,62px);line-height:1.02;letter-spacing:-.03em;color:#fff;max-width:20ch;margin-bottom:18px}
.pdesc{font-size:19px;line-height:1.55;color:rgba(255,255,255,.72);max-width:62ch}
.pmeta{display:flex;gap:30px;flex-wrap:wrap;margin-top:28px;padding-top:24px;border-top:1px solid rgba(255,255,255,.16)}
.pm{min-width:120px}
.pm-k{font-family:var(--mono);font-size:10px;letter-spacing:.15em;text-transform:uppercase;color:rgba(255,255,255,.42);margin-bottom:6px}
.pm-v{font-family:var(--mono);font-size:13.5px;color:#fff}
.pm-v.ok{color:#4ED18C}

/* stack strip */
.strip{background:var(--night-2);border-bottom:1px solid var(--night-line);padding:16px 0}
.chips{display:flex;gap:8px;flex-wrap:wrap}
.chip{font-family:var(--mono);font-size:10.5px;letter-spacing:.09em;text-transform:uppercase;color:rgba(255,255,255,.66);border:1px solid var(--night-line);padding:5px 11px;border-radius:3px}

/* outcome callout */
.outcome{max-width:var(--read);margin:44px auto 0;padding:0 34px}
.outcome-in{border-left:3px solid var(--oxide);background:var(--paper-2);padding:22px 26px}
.outcome-k{font-family:var(--mono);font-size:10px;letter-spacing:.16em;text-transform:uppercase;color:var(--oxide);margin-bottom:9px}
.outcome-v{font-size:18px;line-height:1.55;color:var(--ink)}

/* ===== markdown prose ===== */
.prose{max-width:var(--read);margin:0 auto;padding:52px 34px 0}
.prose h2{
  font-family:var(--disp);font-weight:700;font-size:clamp(28px,3.4vw,38px);line-height:1.06;
  letter-spacing:-.022em;color:var(--ink);margin:54px 0 18px;padding-top:26px;border-top:1px solid var(--line);
}
.prose h2:first-child{margin-top:0;padding-top:0;border-top:0}
.prose h3{font-family:var(--disp);font-weight:700;font-size:23px;line-height:1.14;letter-spacing:-.018em;color:var(--ink);margin:36px 0 12px}
.prose p{margin-bottom:20px;color:var(--ink-2)}
.prose a{color:var(--oxide);text-decoration:underline;text-underline-offset:3px;text-decoration-thickness:1px}
.prose a:hover{background:var(--paper-2)}
.prose strong{color:var(--ink);font-weight:600}
.prose em{font-style:italic;color:var(--ink)}
.prose ul,.prose ol{margin:0 0 22px 0;padding-left:22px}
.prose li{margin-bottom:9px;color:var(--ink-2)}
.prose li::marker{color:var(--oxide)}
.prose blockquote{
  border-left:3px solid var(--steel);background:var(--paper-2);
  padding:18px 22px;margin:26px 0;color:var(--muted);font-size:16.5px;
}
.prose blockquote p:last-child{margin-bottom:0}
.prose code{
  font-family:var(--mono);font-size:14.5px;background:var(--paper-3);
  border:1px solid var(--line);padding:2px 6px;border-radius:3px;color:var(--ink);
}
.prose pre{
  background:var(--night);border:1px solid var(--night-line);border-radius:4px;
  padding:20px 22px;overflow-x:auto;margin:26px 0;
}
.prose pre code{
  background:none;border:0;padding:0;color:#C7D3CC;font-size:14px;line-height:1.7;
}
.prose hr{border:0;border-top:1px solid var(--line);margin:44px 0}
.prose table{width:100%;border-collapse:collapse;margin:26px 0;font-size:16px}
.prose th{
  font-family:var(--mono);font-size:10.5px;letter-spacing:.13em;text-transform:uppercase;
  color:var(--oxide);text-align:left;padding:11px 14px;border-bottom:1px solid var(--line);background:var(--paper-2);
}
.prose td{padding:12px 14px;border-bottom:1px solid var(--line-2);color:var(--ink-2);vertical-align:top}
.prose tr:last-child td{border-bottom:0}
.prose img{max-width:100%;height:auto;display:block}
.prose figure.shot{margin:34px 0;border:1px solid var(--line);background:var(--paper-2)}
.prose figure.shot img{border-bottom:1px solid var(--line);width:100%}
.prose figure.shot figcaption{padding:16px 20px;font-size:15.5px;color:var(--muted);line-height:1.55}
.prose figure.shot figcaption b{color:var(--ink);font-weight:600}

/* skills */
.skills{max-width:var(--read);margin:56px auto 0;padding:0 34px}
.skills-k{font-family:var(--mono);font-size:10.5px;letter-spacing:.16em;text-transform:uppercase;color:var(--steel);margin-bottom:14px}
.skills-list{display:flex;gap:8px;flex-wrap:wrap}
.skill{font-family:var(--mono);font-size:11.5px;color:var(--muted);border:1px solid var(--line);padding:6px 12px;border-radius:3px;background:var(--paper-2)}

/* next */
.next{border-top:1px solid var(--line);margin-top:72px;padding:52px 0 0}
.next-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}
.n3{border:1px solid var(--line);background:var(--paper-2);padding:24px;text-decoration:none;color:inherit;transition:all .16s;display:block}
.n3:hover{border-color:var(--oxide);transform:translateY(-3px)}
.n3 h4{font-family:var(--disp);font-weight:700;font-size:19px;color:var(--ink);margin-bottom:8px}
.n3 p{font-size:15.5px;color:var(--muted);line-height:1.5}
.n3 span{font-family:var(--mono);font-size:11px;color:var(--oxide);display:block;margin-top:14px}
footer{padding:34px 0 46px;display:flex;justify-content:space-between;gap:22px;flex-wrap:wrap;align-items:center;border-top:1px solid var(--line);margin-top:52px}
.fn{font-family:var(--mono);font-size:11.5px;color:var(--muted-2);line-height:1.8}
.fl{display:flex;gap:9px;flex-wrap:wrap}
.fl a{font-family:var(--mono);font-size:11.5px;color:var(--muted);text-decoration:none;border:1px solid var(--line);padding:8px 14px;border-radius:3px}
.fl a:hover{color:var(--oxide);border-color:var(--oxide)}

a:focus-visible{outline:2px solid var(--oxide);outline-offset:3px}
@media (max-width:900px){
  .next-grid{grid-template-columns:1fr}
  .phead{padding:48px 0 40px}
  .prose{padding-top:38px}
  .nav-links a:not(.nav-cta){display:none}
}
@media (prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}

/* LIGHTBOX-V20 */
.lb-overlay{
  position:fixed;inset:0;z-index:999;display:none;align-items:center;justify-content:center;
  background:rgba(10,14,16,.92);padding:32px;cursor:zoom-out;
}
.lb-overlay.open{display:flex}
.lb-overlay img{max-width:min(92vw,1400px);max-height:82vh;object-fit:contain;
  border:1px solid var(--line,#C9CFC5);border-radius:4px;box-shadow:0 20px 60px rgba(0,0,0,.5)}
.lb-cap{
  position:absolute;left:0;right:0;bottom:20px;text-align:center;
  font-family:var(--mono,monospace);font-size:13px;color:rgba(255,255,255,.75);
  padding:0 24px;max-width:900px;margin:0 auto;
}
.lb-x{position:absolute;top:18px;right:26px;color:#fff;font-family:var(--mono,monospace);
  font-size:14px;cursor:pointer;border:1px solid rgba(255,255,255,.4);border-radius:3px;padding:8px 12px}
.shot img,.card-img img,.hero-proj-img img,.card-shot img{cursor:zoom-in}

</style>
</head>
<body>

<nav class="nav"><div class="wrap nav-in">
  <a class="brand" href="/"><span class="led"></span>steven-garcia.dev</a>
  <div class="nav-links">
    <a href="/#log">incidents</a><a href="/#work">work</a><a href="/#stack">stack</a>
    <a href="/infrastructure">infrastructure</a>
    <a class="nav-cta" href="/resume.pdf">Résumé</a>
  </div>
</div></nav>

<header class="phead">
  <div class="phead-bg"><img src="/photos/navy-turbine.webp" alt="" aria-hidden="true" /></div>
  <div class="phead-scrim"></div>
  <div class="phead-in"><div class="wrap">
    <div class="crumb"><a href="/">steven-garcia.dev</a> &nbsp;/&nbsp; <a href="/#work">work</a> &nbsp;/&nbsp; {project.id}</div>
    <h1>{d.title}</h1>
    <p class="pdesc">{d.description}</p>
    <div class="pmeta">
      {dateStr && <div class="pm"><div class="pm-k">Written</div><div class="pm-v">{dateStr}</div></div>}
      {d.status && <div class="pm"><div class="pm-k">Status</div><div class="pm-v ok">{d.status}</div></div>}
      {d.duration && <div class="pm"><div class="pm-k">Duration</div><div class="pm-v">{d.duration}</div></div>}
    </div>
  </div></div>
</header>

{d.stack && d.stack.length > 0 && (
  <div class="strip"><div class="wrap"><div class="chips">
    {d.stack.map((s) => <span class="chip">{s}</span>)}
  </div></div></div>
)}

{d.outcome && (
  <div class="outcome"><div class="outcome-in">
    <div class="outcome-k">Outcome</div>
    <div class="outcome-v">{d.outcome}</div>
  </div></div>
)}

<article class="prose">
  <slot />
</article>

{d.skills && d.skills.length > 0 && (
  <section class="skills">
    <div class="skills-k">What this demonstrates</div>
    <div class="skills-list">{d.skills.map((s) => <span class="skill">{s}</span>)}</div>
  </section>
)}

<section class="next"><div class="wrap">
  <div class="next-grid">
    <a class="n3" href="/#work"><h4>All write-ups</h4><p>Ten projects, each with the commands, the output, and the mistakes in between.</p><span>Back to the list →</span></a>
    <a class="n3" href="/infrastructure"><h4>Infrastructure</h4><p>The whole environment on one page. What runs where, and how it connects.</p><span>See the system →</span></a>
    <a class="n3" href="https://www.linkedin.com/in/steven-garcia-cis/"><h4>Get in touch</h4><p>Open to help desk, systems administration, and infrastructure support roles.</p><span>Say hello →</span></a>
  </div>
  <footer>
    <div class="fn">Built, broken, and fixed by me. Served from my own Kubernetes cluster.<br>Section photography: U.S. Navy, public domain.</div>
    <div class="fl"><a href="/resume.pdf">Résumé</a><a href="https://github.com/darthsteven444-code">GitHub</a><a href="https://www.linkedin.com/in/steven-garcia-cis/">LinkedIn</a><a href="/">Home</a></div>
  </footer>
</div></section>


<div class="lb-overlay" id="lb">
  <span class="lb-x">Close &times;</span>
  <img id="lb-img" src="" alt="" />
  <div class="lb-cap" id="lb-cap"></div>
</div>

<script>
/* LIGHTBOX-V20 */
(function(){
  const ov = document.getElementById('lb');
  const im = document.getElementById('lb-img');
  const cap = document.getElementById('lb-cap');
  function openLb(src, alt, caption){
    im.src = src; im.alt = alt || '';
    cap.textContent = caption || '';
    ov.classList.add('open');
  }
  function closeLb(){ ov.classList.remove('open'); im.src=''; }
  document.querySelectorAll('.shot img, .card-img img, .hero-proj-img img, .card-shot img').forEach(img=>{
    img.addEventListener('click', ()=>{
      const figcap = img.closest('figure')?.querySelector('figcaption');
      openLb(img.currentSrc || img.src, img.alt, figcap ? figcap.textContent.trim() : '');
    });
  });
  ov.addEventListener('click', closeLb);
  document.addEventListener('keydown', e=>{ if(e.key === 'Escape') closeLb(); });
})();
</script>

</body>
</html>
