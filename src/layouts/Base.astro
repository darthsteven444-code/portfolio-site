---
// src/layouts/Base.astro
import '../styles/global.css';

const { title, description } = Astro.props;
const pageTitle = title ? `${title} — Steven Garcia` : 'Steven Garcia — Infrastructure & Systems';
const desc = description ?? 'Navy veteran and CIS student running a 17-VM homelab: Kubernetes, Active Directory, a SIEM, and tested backups. Built, broken, and documented by me.';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={desc} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#0B1120" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>

  <body>
    <div class="wrap">
      <nav class="nav">
        <div class="shell nav-in">
          <a class="brand" href="/">
            <span class="dot" aria-hidden="true"></span>
            steven-garcia.dev
          </a>
          <a class="nav-link nav-hide" href="/infrastructure">infrastructure</a>
          <a class="nav-link nav-hide" href="/#work">work</a>
          <a class="nav-cta" href="/resume.pdf">résumé</a>
        </div>
      </nav>

      <main>
        <slot />
      </main>

      <footer class="foot">
        <div class="shell">
          <div class="hire" style="margin-bottom:2rem">
            <p class="eyebrow">Currently looking</p>
            <dl class="hire-grid">
              <div>
                <dt>Location</dt>
                <dd>Texas, TX — open to San Antonio &amp; hybrid</dd>
              </div>
              <div>
                <dt>Seeking</dt>
                <dd>Help desk · systems administration · infrastructure support</dd>
              </div>
              <div>
                <dt>Studying</dt>
                <dd>A.A.S. Computer Information Systems, graduating May 2027</dd>
              </div>
              <div>
                <dt>Background</dt>
                <dd>U.S. Navy veteran — Gas Turbine Systems Technician (Electrical)</dd>
              </div>
            </dl>
          </div>

          <div class="foot-in">
            <p class="foot-note">Built, broken, and fixed by me. Served from my own Kubernetes cluster.</p>
            <div class="chip-row">
              <a class="btn btn-ghost" href="/resume.pdf">Résumé</a>
              <a class="btn btn-ghost" href="https://github.com/darthsteven444-code" target="_blank" rel="noopener">GitHub</a>
              <a class="btn btn-ghost" href="https://www.linkedin.com/in/steven-garcia-cis/" target="_blank" rel="noopener">LinkedIn</a>
              <a class="btn btn-ghost" href="mailto:contact@steven-garcia.dev">Email</a>
            </div>
          </div>
        </div>
      </footer>
    </div>

    <script is:inline>
      (function () {
        var items = document.querySelectorAll('.reveal');
        if (!items.length) return;
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          items.forEach(function (el) { el.classList.add('in'); });
          return;
        }
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (e) {
            if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
          });
        }, { rootMargin: '0px 0px -12% 0px', threshold: 0.05 });
        items.forEach(function (el) { io.observe(el); });
      })();
    </script>
  </body>
</html>
