---
import Base from "../layouts/Base.astro";

const links = [
  { label: "github", href: "https://github.com/darthsteven444-code" },
  { label: "linkedin", href: "https://www.linkedin.com/in/steven-garcia-cis/" },
  { label: "email", href: "mailto:contact@steven-garcia.dev" },
];

const projects = [
  {
    title: "Homelab",
    blurb: "Multi-VLAN Proxmox lab — Active Directory, PKI, OPNsense firewall, Ubuntu services, full monitoring stack.",
    href: "/projects/homelab",
  },
  {
    title: "This Site",
    blurb: "The site you're reading — Astro on Ubuntu + nginx, fronted by Cloudflare Tunnel, with Prometheus uptime probes and Discord alerts.",
    href: "/projects/this-site",
  },
  {
    title: "System-Health Monitor",
    blurb: "Bash health-monitoring script with thresholds, journalctl forensics, and Discord alerting via a systemd timer.",
    href: "/projects/system-health",
  },
  {
    title: "Windows Server Domain & PKI",
    blurb: "Built a Windows Server 2022 domain controller, authored custom certificate templates, and issued trusted TLS certs to lab services.",
    href: "/projects/ad-pki",
  },
];
---
<Base>
  <header class="mb-16">
    <h1 class="text-3xl font-semibold tracking-tight">Steven Garcia</h1>
    <p class="text-zinc-400 mt-2">Navy Veteran · CIS Student · Homelab Engineer</p>
  </header>

  <section class="mb-16">
    <h2 class="text-sm uppercase tracking-widest text-zinc-500 mb-4">about</h2>
    <p class="text-zinc-300 leading-relaxed">
      I'm Steven — transitioning into IT after a decade across Navy engineering, hospital technology, and state facility infrastructure. Currently studying Computer Information Systems at Southwest Texas College and running a multi-VLAN homelab where I learn the tools real teams run.
    </p>
    <p class="text-zinc-300 leading-relaxed mt-4">
      This site itself runs on my own infrastructure: Ubuntu + nginx, behind Cloudflare, monitored with Prometheus and Grafana.
    </p>
  </section>

  <section class="mb-16">
    <h2 class="text-sm uppercase tracking-widest text-zinc-500 mb-4">projects</h2>
    <ul class="space-y-6">
      {projects.map((p) => (
        <li>
          <a href={p.href} class="group block">
            <h3 class="font-medium text-zinc-100 group-hover:text-white">
              {p.title} <span class="text-zinc-600 group-hover:text-zinc-400">→</span>
            </h3>
            <p class="text-zinc-400 text-sm mt-1">{p.blurb}</p>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="mb-16">
    <h2 class="text-sm uppercase tracking-widest text-zinc-500 mb-4">elsewhere</h2>
    <ul class="flex gap-6 text-zinc-300">
      {links.map((l) => (
        <li>
          <a href={l.href} class="lowercase underline decoration-zinc-600 hover:decoration-zinc-100" target="_blank" rel="noopener">
            {l.label}
          </a>
        </li>
      ))}
    </ul>
  </section>

  <footer class="text-xs text-zinc-600 mt-24">
    steven-garcia.dev · self-hosted on a homelab in uvalde, tx
  </footer>
</Base>
