---
import Base from "../layouts/Base.astro";

const links = [
  { label: "github", href: "https://github.com/darthsteven444-code" },
  { label: "linkedin", href: "https://www.linkedin.com/in/steven-garcia-cis/" },
  { label: "email", href: "mailto:contact@steven-garcia.dev" },
];

const projects = [
  {
    title: "Homelab",
    blurb: "Multi-VLAN Proxmox lab — Active Directory, PKI, OPNsense firewall, Ubuntu services, full monitoring stack.",
    href: "/projects/homelab",
  },
  {
    title: "This Site",
    blurb: "The site you're reading — Astro on Ubuntu + nginx, fronted by Cloudflare Tunnel, with Prometheus uptime probes and Discord alerts.",
    href: "/projects/this-site",
  },
  {
    title: "System-Health Monitor",
    blurb: "Bash health-monitoring script with thresholds, journalctl forensics, and Discord alerting via a systemd timer.",
    href: "/projects/system-health",
  },
  {
    title: "Windows Server Domain & PKI",
    blurb: "Built a Windows Server 2022 domain controller, authored custom certificate templates, and issued trusted TLS certs to lab services.",
    href: "/projects/ad-pki",
  },
  {
    title: "Hospital IT Lab",
    blurb: "A hospital in a jar — isolated AD forest, HIPAA-style GPO hardening, GLPI service desk, and zero-trust browser RDP. Built from scratch, sealed off from production.",
    href: "/projects/hospital-it-lab",
  },
  {
    title: "Hardening a Kubernetes Cluster",
    blurb: "Took a live k3s cluster from 'it works' to 'it's defended' — Trivy image scanning, RBAC, Pod Security, default-deny NetworkPolicy, and proving detection with a live attack watched in Wazuh.",
    href: "/projects/k8s-security-hardening",
  },
  {
    title: "Backups That Actually Restore",
    blurb: "A two-layer disaster-recovery strategy — Velero for cluster state, Proxmox for VM disks — restore-tested by deliberately deleting things and bringing them back.",
    href: "/projects/backup-dr",
  },
  {
    title: "The Pipeline That Ships This Site",
    blurb: "A GitHub Actions CI/CD pipeline that builds a hardened, non-root container image and publishes it to GHCR automatically on every version tag.",
    href: "/projects/cicd-pipeline",
  },
];
---

<Base>
  <header class="mb-14">
    <p class="seclabel mb-3">~/whoami<span class="blink"></span></p>
    <h1 class="text-4xl font-bold tracking-tight">Steven <span class="glow">Garcia</span></h1>
    <p class="text-zinc-400 mt-3" style="font-family:var(--mono);font-size:13.5px;color:var(--dim)">Navy Veteran · CIS Student · Homelab Engineer</p>
  </header>

  <section class="mb-14">
    <h2 class="seclabel mb-4">// about</h2>
    <p class="leading-relaxed" style="color:var(--ink)">
      I'm Steven — transitioning into IT after a decade across Navy engineering, hospital technology, and state facility infrastructure. Currently studying Computer Information Systems at Southwest Texas College and running a multi-VLAN homelab where I learn the tools real teams run.
    </p>
    <p class="leading-relaxed mt-4" style="color:var(--ink)">
      This site itself runs on my own infrastructure: Ubuntu + nginx, behind Cloudflare, monitored with Prometheus and Grafana.
    </p>
  </section>

  <section class="mb-14">
    <h2 class="seclabel mb-4">// projects</h2>
    <ul class="space-y-3">
      {projects.map((p) => (
        <li>
          <a href={p.href} class="proj-card block">
            <h3 class="font-medium">
              {p.title} <span class="arrow">→</span>
            </h3>
            <p class="text-sm mt-1">{p.blurb}</p>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="mb-14">
    <h2 class="seclabel mb-4">// elsewhere</h2>
    <ul class="flex gap-3 flex-wrap">
      {links.map((l) => (
        <li>
          <a href={l.href} class="chip" target="_blank" rel="noopener">{l.label}</a>
        </li>
      ))}
    </ul>
  </section>

  <footer class="foot mt-24">
    <span class="accent">$</span> self-hosted on a homelab in uvalde, tx
  </footer>
</Base>
