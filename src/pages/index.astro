addEventListener('scroll',()=>{nav.classList.toggle('solid',scrollY>window.innerHeight-90)},{passive:true});
const items=[['proxmox','17 guests · 88 threads · 125 GiB'],['kubernetes','k3s v1.36 · 3 nodes'],['siem','<b>7 agents active</b>'],['backups','<b>daily · 2 targets</b>'],['storage','ZFS RAIDZ1 · 10.4 TiB'],['segments','5 VLANs · <em>default deny</em>'],['cloud','Oracle OKE · ARM · always free'],['this page','<b>served from my own cluster</b>']];
const row=items.map(([k,v])=>`<span>${k} &nbsp;${v}</span>`).join('');
document.getElementById('tick').innerHTML=row+row;
const io=new IntersectionObserver(es=>{es.forEach(e=>{if(e.isIntersecting){e.target.classList.add('in');io.unobserve(e.target)}})},{threshold:.05,rootMargin:'0px 0px -50px 0px'});
document.querySelectorAll('.rv').forEach(el=>io.observe(el));
new IntersectionObserver((es,o)=>{es.forEach(e=>{if(e.isIntersecting){e.target.classList.add('drawn');o.unobserve(e.target)}})},{threshold:.25}).observe(document.getElementById('plate'));
const reduce=matchMedia('(prefers-reduced-motion: reduce)').matches;
const cio=new IntersectionObserver(es=>{es.forEach(e=>{
  if(!e.isIntersecting)return; cio.unobserve(e.target);
  const el=e.target,to=+el.dataset.count,sfx=el.dataset.suffix||'';
  if(reduce){el.textContent=to+sfx;return}
  const t0=performance.now(),dur=1100;
  const step=t=>{const p=Math.min((t-t0)/dur,1);el.textContent=Math.round(to*(1-Math.pow(1-p,3)))+sfx;if(p<1)requestAnimationFrame(step)};
  requestAnimationFrame(step);
})},{threshold:.5});
document.querySelectorAll('[data-count]').forEach(el=>cio.observe(el));
</script>
