---
import { getCollection } from 'astro:content';

const ORDER = [
  'infrastructure',
  'security and monitoring',
  'windows and identity',
  'service desk',
  'cloud and delivery',
  'other',
];

const META = {
  'homelab': {
    cat: 'infrastructure',
    name: 'the homelab',
    blurb: 'Multi VLAN Proxmox lab, Active Directory, OPNsense, monitoring.',
  },
  'backup-dr': {
    cat: 'infrastructure',
    name: 'backups that actually restore',
    blurb: 'Two layer disaster recovery, proven by deleting things on purpose.',
  },
  'k8s-security-hardening': {
    cat: 'security and monitoring',
    name: 'hardening a kubernetes cluster',
    blurb: 'RBAC, pod security, default deny networking, and a real attack to prove detection.',
  },
  'vulnerability-management': {
    cat: 'security and monitoring',
    name: 'scanning my own cluster from three places',
    blurb: 'Same scanner, three network positions, three completely different answers.',
  },
  'system-health': {
    cat: 'security and monitoring',
    name: 'system health monitoring',
    blurb: 'Bash health monitor on a timer, alerts to Discord, and one silent bug.',
  },
  'ad-pki': {
    cat: 'windows and identity',
    name: 'active directory and pki',
    blurb: 'Domain controller, enterprise root CA, custom certificate templates.',
  },
  'hospital-it-lab': {
    cat: 'service desk',
    name: 'hospital it lab',
    blurb: 'Isolated hospital environment with a GLPI service desk and browser RDP.',
    chip: 'live demo',
  },
  'cloud-cost-analysis': {
    cat: 'cloud and delivery',
    name: 'what cloud actually costs',
    blurb: 'The same workload on my own hardware and in Oracle Cloud, with the real math.',
  },
  'cicd-pipeline': {
    cat: 'cloud and delivery',
    name: 'the pipeline that ships this site',
    blurb: 'Tag a release, the image builds and pushes, the cluster rolls itself.',
  },
  'this-site': {
    cat: 'cloud and delivery',
    name: 'this website',
    blurb: 'Astro source to container to cluster, watched end to end.',
  },
};

const entries = await getCollection('projects');

const items = entries
  .map((e) => {
    const slug = e.id.replace(/\.(md|mdx)$/, '');
    const m = META[slug] || {};
    return {
      slug,
      name: m.name || e.data.title,
      blurb: m.blurb || e.data.description,
      cat: e.data.category || m.cat || 'other',
      chip: m.chip || 'running',
      date: e.data.date,
    };
  })
  .sort((a, b) => (b.date && a.date ? b.date - a.date : 0));

const groups = ORDER
  .map((name) => ({ name, items: items.filter((i) => i.cat === name) }))
  .filter((g) => g.items.length > 0);

const anchor = (s) => s.toLowerCase().replace(/[^a-z0-9]+/g, '-');
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>projects | steven-garcia.dev</title>
<meta name="description" content="Every write up from the homelab, grouped by discipline." />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans+Condensed:wght@400;500;600&family=IBM+Plex+Sans:wght@400;500&display=swap" />
<style>
  :root{
    --paper:#EDEFEA; --paper-2:#E4E7DF; --ink:#16181A; --ink-2:#4A5054;
    --rule:#C9CCC4; --rule-2:#DBDED6; --oxide:#A0391F; --oxide-dk:#7A2B16;
    --oxide-bg:#F0DED8; --deck:#2C4A32; --deck-bg:#DDE6DD;
  }
  *{box-sizing:border-box}
  body{margin:0;background:var(--paper);color:var(--ink);
    font-family:'IBM Plex Sans',system-ui,sans-serif;font-size:16px;line-height:1.55}
  a{color:inherit;text-decoration:none}
  .ribbon{height:3px;background:var(--oxide)}
  .wrap{max-width:1040px;margin:0 auto;padding:0 24px}
  .nav{background:var(--paper-2);border-bottom:1px solid var(--rule)}
  .nav-in{display:flex;align-items:center;justify-content:space-between;
    gap:16px;padding:13px 24px;flex-wrap:wrap;max-width:1040px;margin:0 auto}
  .brand{font-family:'IBM Plex Mono',monospace;font-size:14px;font-weight:500;
    display:inline-flex;align-items:center;gap:8px}
  .led{width:7px;height:7px;border-radius:50%;background:#3E8E4F;display:inline-block}
  .nav-links{font-family:'IBM Plex Mono',monospace;font-size:13px;
    display:flex;align-items:center;gap:18px;flex-wrap:wrap}
  .nav-links a{color:var(--ink-2)}
  .nav-links a:hover{color:var(--ink)}
  .nav-links a.here{color:var(--oxide);border-bottom:2px solid var(--oxide);padding-bottom:2px}
  .nav-cta{border:1px solid var(--ink);padding:4px 12px;color:var(--ink)!important}
  .nav-cta:hover{background:var(--ink);color:var(--paper)!important}
  main{padding:44px 0 68px}
  h1{font-family:'IBM Plex Sans Condensed',sans-serif;font-size:42px;font-weight:600;
    line-height:1.08;margin:0 0 12px;letter-spacing:-0.01em}
  .lede{color:var(--ink-2);margin:0 0 10px;max-width:62ch}
  .count{font-family:'IBM Plex Mono',monospace;font-size:12px;color:var(--ink-2);
    letter-spacing:0.08em;text-transform:uppercase;margin:0}
  .cols{display:grid;grid-template-columns:210px minmax(0,1fr);gap:44px;margin-top:36px}
  .rail{font-family:'IBM Plex Mono',monospace;font-size:12.5px;line-height:2.15;
    border-right:1px solid var(--rule);padding-right:20px;position:sticky;top:22px;align-self:start}
  .rail-label{font-size:11px;letter-spacing:0.1em;text-transform:uppercase;
    color:var(--ink-2);display:block;margin-bottom:8px}
  .rail a{display:block;color:var(--ink-2)}
  .rail a:hover{color:var(--oxide)}
  .rail .n{color:var(--rule);margin-left:6px}
  .group + .group{margin-top:36px}
  .group h2{font-family:'IBM Plex Mono',monospace;font-size:12px;font-weight:500;
    letter-spacing:0.12em;text-transform:uppercase;color:var(--ink-2);margin:0 0 6px;
    padding-bottom:8px;border-bottom:1px solid var(--rule);scroll-margin-top:22px}
  .row{display:flex;align-items:baseline;justify-content:space-between;gap:20px;
    padding:13px 0;border-bottom:1px solid var(--rule-2)}
  .row:hover .rt{color:var(--oxide)}
  .rt{font-size:17px;font-weight:500;line-height:1.3;display:block}
  .rd{font-size:14px;color:var(--ink-2);margin-top:2px;max-width:64ch;display:block}
  .chip{font-family:'IBM Plex Mono',monospace;font-size:11px;padding:3px 9px;
    border-radius:3px;white-space:nowrap;background:var(--deck-bg);color:var(--deck);flex:none}
  .chip.demo{background:var(--oxide-bg);color:var(--oxide-dk)}
  .foot{border-top:1px solid var(--rule);background:var(--paper-2);
    font-family:'IBM Plex Mono',monospace;font-size:12.5px;color:var(--ink-2)}
  .foot .wrap{padding:20px 24px 26px;display:flex;gap:18px;flex-wrap:wrap}
  .foot a{color:var(--oxide)}
  @media(max-width:760px){
    .cols{grid-template-columns:1fr;gap:26px}
    .rail{border-right:0;border-bottom:1px solid var(--rule);padding:0 0 14px;position:static}
    .rail a{display:inline-block;margin-right:18px}
    h1{font-size:31px}
  }
</style>
</head>
<body>
<div class="ribbon"></div>

<nav class="nav"><div class="nav-in">
  <a class="brand" href="/"><span class="led"></span>steven-garcia.dev</a>
  <div class="nav-links">
    <a href="/#log">incidents</a><a href="/#work">work</a><a href="/#stack">stack</a>
    <a class="here" href="/projects">projects</a>
    <a href="/infrastructure">infrastructure</a>
    <a class="nav-cta" href="/resume.pdf">Résumé</a>
  </div>
</div></nav>

<main>
  <div class="wrap">
    <h1>project index</h1>
    <p class="lede">Everything I have built, broken, and put back together in my own lab,
      grouped by discipline. Each write up has the commands, the output, and the mistakes
      in between.</p>
    <p class="count">{items.length} write ups</p>

    <div class="cols">
      <aside class="rail">
        <span class="rail-label">jump to</span>
        {groups.map((g) => (
          <a href={'#' + anchor(g.name)}>{g.name}<span class="n">{g.items.length}</span></a>
        ))}
      </aside>
      <div>
        {groups.map((g) => (
          <section class="group">
            <h2 id={anchor(g.name)}>{g.name}</h2>
            {g.items.map((i) => (
              <a class="row" href={'/projects/' + i.slug}>
                <span>
                  <span class="rt">{i.name}</span>
                  <span class="rd">{i.blurb}</span>
                </span>
                <span class={i.chip === 'live demo' ? 'chip demo' : 'chip'}>{i.chip}</span>
              </a>
            ))}
          </section>
        ))}
      </div>
    </div>
  </div>
</main>

<footer class="foot"><div class="wrap">
  <span>Texas, Texas</span><span>Navy veteran</span><span>studying computer information systems</span>
  <a href="/resume.pdf">Résumé</a>
  <a href="https://github.com/darthsteven444-code">GitHub</a>
  <a href="https://www.linkedin.com/in/steven-garcia-cis/">LinkedIn</a>
</div></footer>
</body>
</html>
