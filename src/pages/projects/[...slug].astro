---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---
<Base title={entry.data.title} description={entry.data.description}>
  <a href="/" class="text-zinc-500 hover:text-zinc-100 text-sm">← back</a>
  <article class="mt-8 prose prose-invert prose-zinc max-w-none">
    <header class="mb-8 not-prose">
      <h1 class="text-3xl font-semibold lowercase">{entry.data.title}</h1>
      <p class="text-zinc-500 text-sm mt-2">
        {entry.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
      </p>
    </header>
    <Content />
  </article>
</Base>
